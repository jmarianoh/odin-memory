{
  "version": 1,
  "comment": "Mapea rutas del repositorio de origen (globs) a módulos JS y documentos de implementacion/. El orden importa: gana la primera coincidencia dentro de cada categoría.",
  "excluded": [
    "internal/obsidian/**",
    "plugin/**",
    "internal/setup/plugins/**",
    "internal/setup/opencode_jsonc.go",
    "internal/setup/codex_toml.go",
    "cmd/engram/obsidian*.go",
    "cmd/engram/hook_claude*.go",
    "cmd/engram/hook_codex*.go",
    "skills/**",
    ".claude-plugin/**",
    ".devcontainer/**",
    ".gitattributes",
    ".gitignore",
    "assets/**",
    "setup.sh",
    "TRADEMARKS.md",
    "CODEOWNERS"
  ],
  "docsOrCi": [
    "docs/**",
    "*.md",
    ".github/**",
    ".goreleaser.yaml",
    "Makefile",
    "scripts/**",
    "odd/**",
    "tools/**",
    "dependabot_config_test.go",
    "coderabbit_config_test.go",
    "release_*_test.go"
  ],
  "map": [
    { "go": ["internal/store/**"], "js": ["src/store/**"], "doc": "10-store/", "phase": "F1" },
    { "go": ["internal/project/**", "internal/identityfile/**"], "js": ["src/project/**"], "doc": "11-proyecto.md", "phase": "F2" },
    { "go": ["internal/mcp/**"], "js": ["src/mcp/**"], "doc": "12-mcp/", "phase": "F3" },
    { "go": ["internal/server/**", "internal/hostbind/**"], "js": ["src/server/**", "src/hostbind/**"], "doc": "14-http-api/", "phase": "F4" },
    { "go": ["cmd/engram/**"], "js": ["src/cli/**", "bin/odin.js"], "doc": "15-cli/", "phase": "F4" },
    { "go": ["internal/sync/**"], "js": ["src/sync/**"], "doc": "16-git-sync.md", "phase": "F5" },
    { "go": ["internal/llm/**"], "js": ["src/llm/**"], "doc": "17-conflictos-llm.md", "phase": "F6" },
    { "go": ["internal/diagnostic/**"], "js": ["src/diagnostic/**"], "doc": "18-doctor.md", "phase": "F6" },
    { "go": ["internal/selftest/**"], "js": ["src/selftest/**"], "doc": "20-selftest.md", "phase": "F6" },
    { "go": ["internal/version/**"], "js": ["src/version/**"], "doc": "03-entorno-dependencias.md", "phase": "F0" },
    { "go": ["internal/setup/**"], "js": ["src/setup/**"], "doc": "21-copilot-vscode.md", "phase": "F7" },
    { "go": ["internal/tui/**"], "js": ["src/tui/**"], "doc": "19-tui.md", "phase": "F8" },
    { "go": ["internal/cloud/**", "internal/cloudconfig/**"], "js": ["src/cloud/**", "src/cli/commands/cloud.js", "src/store/enrollment.js"], "doc": "30-cloud/", "phase": "F9" },
    { "go": ["internal/agentops/**", "internal/timeutil/**", "internal/command/**"], "js": ["src/**"], "doc": "01-arquitectura.md", "phase": "F1" },
    { "go": ["docker/**", "docker-compose*.yml"], "js": ["docker/**", "docker-compose.cloud.yml"], "doc": "30-cloud/", "phase": "F9" },
    { "go": ["go.mod", "go.sum"], "js": ["package.json"], "doc": "03-entorno-dependencias.md", "phase": "F0" }
  ],
  "contracts": {
    "tool-contract.json": "Cambia parámetros de herramientas MCP → docs 12-mcp/ y fuentes",
    "mcp-tools.json": "Cambian descripciones, anotaciones, defer_loading o instrucciones del servidor → 12-mcp/",
    "sqlite-schema.json": "Cambia el esquema → 10-store/, migración y cambios/<versión>.md",
    "http-routes.json": "Cambian rutas HTTP → 14-http-api/",
    "cli-usage.txt": "Cambian comandos o flags → 15-cli/",
    "protocol.md": "Cambia el protocolo de memoria → 13-protocolo-memoria.md y fuentes",
    "agent-contract.json": "Cambia el contrato de agente → 21-copilot-vscode.md y 23-hooks-copilot.md"
  }
}
